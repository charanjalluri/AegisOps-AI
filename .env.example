# ==============================================================================
# AegisOps AI - Environment Configuration
# Copy this file to .env: `cp .env.example .env` (or `make setup`)
# ==============================================================================

AEGISOPS_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL (Dual Database Topology: aegisops_db + demo_payment_db)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AEGISOPS_DB_NAME=aegisops_db
AEGISOPS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegisops_db
AEGISOPS_DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/aegisops_db

DEMO_PAYMENT_DB_NAME=demo_payment_db
DEMO_PAYMENT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demo_payment_db
DEMO_PAYMENT_DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/demo_payment_db

# ------------------------------------------------------------------------------
# Apache Kafka (KRaft Mode: Host access on 29092, Docker network on 9092)
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:9092
KAFKA_UI_PORT=8080

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_URL_DOCKER=http://qdrant:6333

# ------------------------------------------------------------------------------
# Prometheus & Grafana Observability
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# n8n Workflow Automation
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_URL=http://localhost:5678
N8N_URL_DOCKER=http://n8n:5678

# ------------------------------------------------------------------------------
# Application Services
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=8001

# ------------------------------------------------------------------------------
# Future Phase Placeholders (Not utilized in Phase 1)
# ------------------------------------------------------------------------------
LLM_PROVIDER=muse_spark
LLM_API_KEY=
GITHUB_TOKEN=
